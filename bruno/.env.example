# Vorlage. Kopieren nach .env und ausfüllen – .env ist in .gitignore ausgeschlossen.

# Basis-URL bis einschliesslich /api/v1, ohne Schrägstrich am Ende.
# Muster: https://<subdomain>.prosonata.software/api/v1
PROSONATA_BASE_URL=

# Persönlicher Benutzer-Key aus ProSonata > Benutzer. Nicht der Key einer App-Integration:
# eine Integration ist kein Benutzer, damit wäre offen, wem ein erzeugter Zeiteintrag
# gehört, und userID=myself hätte keinen Bezugspunkt. Siehe KONZEPT.md §9.
PROSONATA_API_KEY=

# Nur nötig, wenn statt des Benutzer-Keys eine App-Integration verwendet wird. Dann
# ausserdem in collection.bru den Header X-APP-ID ergänzen.
PROSONATA_APP_ID=

# IDs aus dem Konto. Jede steht in der Antwort der jeweiligen Listen-Anfrage; nur
# PROSONATA_INVOICE_ID muss aus ProSonata selbst kommen, weil es keine Rechnungsliste
# gibt. Leer lassen, was nicht gebraucht wird.
PROSONATA_PROJECT_ID=
PROSONATA_PROJECT_ID_ALT=
PROSONATA_CUSTOMER_ID=
PROSONATA_CONTACT_ID=
PROSONATA_ADDRESS_ID=
PROSONATA_CATEGORY_ID=
PROSONATA_USER_ID=
PROSONATA_QUOTATION_ID=
PROSONATA_CRM_EVENT_ID=
PROSONATA_EXTERNAL_COST_ID=
PROSONATA_SERVICE_TEMPLATE_ID=
PROSONATA_PROJECT_TASK_ID=
PROSONATA_INVOICE_ID=

# timeID eines vorhandenen Testeintrags – für zeiterfassung/11 und 12.
# Anders als createdId überlebt sie das Neuladen der Sammlung.
PROSONATA_TIME_ID=
