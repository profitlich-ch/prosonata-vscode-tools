meta {
  name: Adressen auflisten
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/addresses?perPage=10
  body: none
  auth: none
}

params:query {
  perPage: 10
}

assert {
  res.status: eq 200
}

docs {
  `GET /api/v1/addresses`

  Antwortumschlag `{ meta, data }`; in `meta` stehen `perPage`, `page`, `totalCount`,
  `apiLimitRemaining` und `apiLimitReset`.

  Die ID für den Einzelabruf hier entnehmen und als `addressId` in die `.env` eintragen.
}
