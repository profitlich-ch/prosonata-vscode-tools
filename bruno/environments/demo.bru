vars {
  baseUrl: {{process.env.PROSONATA_BASE_URL}}
  apiKey: {{process.env.PROSONATA_API_KEY}}
  appId: {{process.env.PROSONATA_APP_ID}}
  projectId: {{process.env.PROSONATA_PROJECT_ID}}
  projectIdAlt: {{process.env.PROSONATA_PROJECT_ID_ALT}}
  customerId: {{process.env.PROSONATA_CUSTOMER_ID}}
  contactId: {{process.env.PROSONATA_CONTACT_ID}}
  addressId: {{process.env.PROSONATA_ADDRESS_ID}}
  categoryId: {{process.env.PROSONATA_CATEGORY_ID}}
  userId: {{process.env.PROSONATA_USER_ID}}
  quotationId: {{process.env.PROSONATA_QUOTATION_ID}}
  crmEventId: {{process.env.PROSONATA_CRM_EVENT_ID}}
  externalCostId: {{process.env.PROSONATA_EXTERNAL_COST_ID}}
  serviceTemplateId: {{process.env.PROSONATA_SERVICE_TEMPLATE_ID}}
  projectTaskId: {{process.env.PROSONATA_PROJECT_TASK_ID}}
  timeId: {{process.env.PROSONATA_TIME_ID}}
  invoiceId: {{process.env.PROSONATA_INVOICE_ID}}
}
