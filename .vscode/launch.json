{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extension in der Spielwiese",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.sandbox/repo"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "npm: build",
      "env": {
        "PROSONATA_HOME": "${workspaceFolder}/.sandbox/home"
      }
    },
    {
      "name": "Extension im echten Konto",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "npm: build"
    }
  ]
}
