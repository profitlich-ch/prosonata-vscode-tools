{
  "name": "prosonata-vscode-tools",
  "displayName": "ProSonata Tools",
  "description": "%description%",
  "version": "0.25.0",
  "publisher": "Profitlich",
  "repository": {
    "type": "git",
    "url": "https://github.com/profitlich-ch/prosonata-vscode-tools.git"
  },
  "license": "MIT",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "time tracking",
    "prosonata",
    "git",
    "invoicing"
  ],
  "engines": {
    "node": ">=20",
    "vscode": "^1.75.0"
  },
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "bin": {
    "prosonata": "./dist/cli.cjs"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "profitlich",
          "title": ":Profitlich",
          "icon": "media/icon-activity.svg"
        }
      ]
    },
    "views": {
      "profitlich": [
        {
          "id": "prosonata.panel",
          "name": "%view.panel.name%",
          "icon": "media/icon-view.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "prosonata.setup",
        "title": "%command.setup.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.start",
        "title": "%command.start.title%",
        "icon": "$(play)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.pause",
        "title": "%command.pause.title%",
        "icon": "$(debug-pause)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.toggle",
        "title": "%command.toggle.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.send",
        "title": "%command.send.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.closeEntry",
        "title": "%command.closeEntry.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.changeText",
        "title": "%command.changeText.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.resolveClosedElsewhere",
        "title": "%command.resolveClosedElsewhere.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.handleRejected",
        "title": "%command.handleRejected.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.handleResting",
        "title": "%command.handleResting.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.adjust",
        "title": "%command.adjust.title%",
        "icon": "$(edit)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.discard",
        "title": "%command.discard.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.attachToLast",
        "title": "%command.attachToLast.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.log",
        "title": "%command.log.title%",
        "icon": "$(history)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.chooseProject",
        "title": "%command.chooseProject.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.chooseCategory",
        "title": "%command.chooseCategory.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.chooseGrid",
        "title": "%command.chooseGrid.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.toggleMode",
        "title": "%command.toggleMode.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.openSettings",
        "title": "%command.openSettings.title%",
        "icon": "$(gear)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.resolveSleep",
        "title": "%command.resolveSleep.title%",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.browse",
        "title": "%command.browse.title%",
        "icon": "$(list-flat)",
        "category": "ProSonata"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prosonata.browse",
          "when": "view == prosonata.panel && prosonata.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "prosonata.log",
          "when": "view == prosonata.panel",
          "group": "navigation@2"
        },
        {
          "command": "prosonata.openSettings",
          "when": "view == prosonata.panel && prosonata.hasAccount",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "prosonata.adjust",
          "when": "view == prosonata.panel && viewItem == timer",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prosonata.panel",
        "contents": "%viewsWelcome.noAccount%",
        "when": "!prosonata.hasAccount"
      },
      {
        "view": "prosonata.panel",
        "contents": "%viewsWelcome.noProject%",
        "when": "prosonata.hasAccount && !prosonata.hasProject"
      },
      {
        "view": "prosonata.panel",
        "contents": "%viewsWelcome.noFolder%",
        "when": "prosonata.hasAccount && !workspaceFolderCount"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "install-vsix": "node scripts/install.mjs",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.75.0",
    "@usebruno/cli": "^4.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "icon": "media/icon.png",
  "dependencies": {
    "@vscode/l10n": "0.0.18"
  }
}
