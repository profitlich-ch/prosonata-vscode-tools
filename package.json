{
  "name": "prosonata-vscode-tools",
  "displayName": ":Profitlich",
  "description": "Verbindet VS Code mit ProSonata. Vorerst: Zeiterfassung, gebunden an Commits und Branches.",
  "version": "0.11.0",
  "publisher": "profitlich",
  "repository": {
    "type": "git",
    "url": "https://github.com/profitlich-ch/prosonata-vscode-tools.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "time tracking",
    "prosonata",
    "git",
    "invoicing"
  ],
  "engines": {
    "node": ">=20",
    "vscode": "^1.75.0"
  },
  "type": "commonjs",
  "main": "./dist/extension.cjs",
  "bin": {
    "prosonata": "./dist/cli.cjs"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "profitlich",
          "title": ":Profitlich",
          "icon": "media/icon-activity.svg"
        }
      ]
    },
    "views": {
      "profitlich": [
        {
          "id": "prosonata.panel",
          "name": "ProSonata Zeiterfassung",
          "icon": "media/icon-view.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "prosonata.setup",
        "title": "Konto einrichten",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.start",
        "title": "Timer starten",
        "icon": "$(play)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.pause",
        "title": "Timer pausieren",
        "icon": "$(debug-pause)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.toggle",
        "title": "Timer starten oder pausieren",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.send",
        "title": "Ausstehende Einträge jetzt senden",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.closeEntry",
        "title": "Zeiteintrag abschliessen",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.changeText",
        "title": "Text des offenen Zeiteintrags ändern",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.resolveClosedElsewhere",
        "title": "Anderswo abgeschlossenen Eintrag entscheiden",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.adjust",
        "title": "Zeit korrigieren",
        "icon": "$(edit)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.discard",
        "title": "Laufendes Segment verwerfen",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.attachToLast",
        "title": "Zeit dem letzten Eintrag zuschlagen",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.log",
        "title": "Log der gemessenen Segmente",
        "icon": "$(history)",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.chooseProject",
        "title": "Projekt für dieses Repository wählen",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.chooseCategory",
        "title": "Zeitkategorie für dieses Projekt wählen",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.chooseGrid",
        "title": "Zeitraster wählen",
        "category": "ProSonata"
      },
      {
        "command": "prosonata.toggleMode",
        "title": "Zwischen einem Eintrag pro Branch und pro Commit wechseln",
        "category": "ProSonata"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prosonata.log",
          "when": "view == prosonata.panel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "prosonata.adjust",
          "when": "view == prosonata.panel && viewItem == timer",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prosonata.panel",
        "contents": "Noch kein Konto eingerichtet.\n\nBasis-URL und persönlicher API-Key gehen nach ~/.prosonata/config.json — auch der Hook muss sie lesen können, VS Codes Secret Storage kommt deshalb nicht in Frage.\n\n[Konto einrichten](command:prosonata.setup)",
        "when": "!prosonata.hasAccount"
      },
      {
        "view": "prosonata.panel",
        "contents": "Dieses Repository hat noch kein Projekt.\n\nMit der Wahl wird auch der post-commit-Hook installiert.\n\n[Projekt wählen](command:prosonata.chooseProject)",
        "when": "prosonata.hasAccount && !prosonata.hasProject"
      },
      {
        "view": "prosonata.panel",
        "contents": "Öffne einen Ordner, um dafür Zeit zu erfassen.",
        "when": "prosonata.hasAccount && !workspaceFolderCount"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "install-vsix": "node scripts/install.mjs",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "icon": "media/icon.png"
}
